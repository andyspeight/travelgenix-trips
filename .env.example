# ---------------------------------------------------------------------------
#  Travelgenix Trips
#  Copy to .env.local. Never commit a filled-in copy.
#
#  A WARNING THAT COST US AN HOUR ON 27 AUG 2026. Vercel's project-import
#  screen reads THIS FILE and pre-fills the environment variable NAMES, blank
#  values and all. Deploying straight from import therefore creates a full set
#  of named variables containing nothing, which looks completely correct in the
#  dashboard and fails silently at runtime. Redeploying does not fix it, since
#  empty stays empty. After importing, open Settings > Environment Variables and
#  EDIT each value, then redeploy. GET /api/health will tell you which state
#  each variable is actually in.
# ---------------------------------------------------------------------------

# The group-trips Supabase project. Service role ONLY,
# server side ONLY. RLS is on with no policies, so this key is the only way in
# and it must never reach the browser. Same variable names as tg-widgets uses,
# so the two stay in step.
TRIPS_SUPABASE_URL=
TRIPS_SUPABASE_SERVICE_ROLE_KEY=

# Where we ask "who is signed in". The tg-widgets cookie SSO is the one identity
# for the whole estate. Trips never issues its own login.
TG_WIDGETS_ORIGIN=https://tg-widgets.vercel.app

# Stripe. Connect STANDARD, application fee ZERO: the operator is the merchant
# of record and we never hold traveller funds. Test keys until go-live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=

# This app's own public origin, used to build Stripe return URLs and the
# absolute links that go into traveller email.
NEXT_PUBLIC_TRIPS_ORIGIN=http://localhost:3000

# Vercel Blob — the media library store (image and video uploads). Create a Blob
# store on the project in Vercel and it injects this automatically; until then,
# uploads return a clean "connect a media store" message and the console still
# works. Never commit a real token.
BLOB_READ_WRITE_TOKEN=

# Pexels stock search in the media picker. The same key the other Travelgenix
# projects use. Server-only; the browser never sees it. Without it, the Upload
# and Library tabs still work and the Stock tab shows a "switch on" message.
PEXELS_API_KEY=
